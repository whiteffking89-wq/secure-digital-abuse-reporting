# Application Environment Configuration
# Copy this file to '.env' and update the values with your secret keys.

FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-very-long-random-secret-key-in-production

# Database Configuration
DATABASE_PATH=data/database/abuse_reporting.db

# Evidence Upload Configuration
# IMPORTANT: Stored outside app/static to prevent unauthorized public web access!
UPLOAD_FOLDER=uploads/evidence
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload limit per file

# ML Model Configuration
ML_MODEL_PATH=data/ml_models/abuse_classifier.joblib
